// ===========================================================================
// 애플리케이션 리포지토리(gitlab.example.com/my-group/sample-app)의 루트에
// `Jenkinsfile` 이름으로 배치한다. 앱 템플릿은 이 리포지토리의 sample-app/ (React + nginx).
//
// 흐름: 테스트/빌드(node) → 이미지 빌드&푸시(kaniko) → gitops 리포지토리 태그 갱신 커밋
//       → Argo CD 가 감지하여 배포 → 배포 완료까지 대기
//   (ci/.gitlab-ci.yml 과 같은 흐름이다. CI 는 둘 중 하나만 쓴다 — README 부록 참고)
//
// 에이전트는 bootstrap/jenkins/casc.yaml 의 Pod 템플릿 `build` 를 쓴다.
// 컨테이너 4개: node / kaniko / tools(kubectl·kustomize·git) / argocd
//
// 자격증명(JCasC 가 jenkins-secrets 에서 주입, README 부록 "설치" 참고)
//   nexus-registry     Nexus docker-hosted push 계정 (kaniko)
//   gitops-repo        gitops 리포지토리 push 용 Project access token
//   argocd-auth-token  argocd account generate-token --account cicd
//
// 브랜치 규칙
//   develop → dev 배포 (Argo CD 자동 동기화)
//   main    → prod 배포 (수동 승인 후, Argo CD 수동 동기화)
// ===========================================================================
pipeline {
  agent { label 'build' }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }

  environment {
    // 평문 HTTP 레지스트리. 노드 containerd 는 이 이름을 localhost:30082 로 보낸다
    REGISTRY      = 'nexus-docker.example.com'
    IMAGE         = "${REGISTRY}/my-group/sample-app"
    // 스킴 없이 적는다. 아래에서 http:// 를 붙인다
    GITOPS_REPO   = 'gitlab.example.com/my-group/gitops-manifests.git'
    // 평문 Ingress. 포트를 생략하면 443 으로 붙을 수 있다
    ARGOCD_SERVER = 'argocd.example.com:80'
  }

  stages {
    stage('준비') {
      steps {
        script {
          // GitLab CI 의 CI_COMMIT_REF_SLUG / CI_COMMIT_SHORT_SHA 와 같은 값을 만든다.
          // multibranch 가 아니면 BRANCH_NAME 이 없으므로 GIT_BRANCH 로 물러선다.
          def raw = env.BRANCH_NAME ?: (env.GIT_BRANCH ?: '')
          raw = raw.replaceFirst('^origin/', '')
          env.BRANCH = raw ?: 'unknown'

          // slug: 소문자로 낮추고 영숫자 외는 '-' 로. GitLab 의 규칙과 맞춘다
          def slug = env.BRANCH.toLowerCase().replaceAll('[^a-z0-9]+', '-')
          slug = slug.replaceAll('^-+', '').replaceAll('-+$', '')
          def sha = (env.GIT_COMMIT ?: '').take(8)
          env.IMAGE_TAG = slug + '-' + sha

          // 브랜치별 배포 대상. 그 외 브랜치는 테스트까지만 돌고 끝난다.
          if (env.BRANCH == 'develop') {
            env.DEPLOY_ENV = 'dev'
          } else if (env.BRANCH == 'main') {
            env.DEPLOY_ENV = 'prod'
          } else {
            env.DEPLOY_ENV = ''
          }
          echo "branch=${env.BRANCH}  tag=${env.IMAGE_TAG}  deploy=${env.DEPLOY_ENV ?: '(없음)'}"
        }
      }
    }

    stage('테스트·빌드') {
      steps {
        container('node') {
          sh '''
            set -eu
            npm ci --no-audit --no-fund
            npm test
            # 이미지 빌드는 Dockerfile 이 다시 하지만, 빌드 오류를 이 단계에서 먼저 잡는다
            npm run build
          '''
        }
      }
    }

    stage('이미지 빌드·푸시') {
      when { expression { env.DEPLOY_ENV } }
      steps {
        container('kaniko') {
          withCredentials([usernamePassword(credentialsId: 'nexus-registry',
                                            usernameVariable: 'REG_USER',
                                            passwordVariable: 'REG_PASS')]) {
            sh '''
              set -eu
              mkdir -p /kaniko/.docker
              AUTH=$(printf '%s:%s' "$REG_USER" "$REG_PASS" | base64 | tr -d '\\n')
              printf '{"auths":{"%s":{"auth":"%s"}}}' "$REGISTRY" "$AUTH" > /kaniko/.docker/config.json

              # --insecure / --skip-tls-verify : 평문 HTTP 레지스트리로 push
              # --insecure-pull                : 평문 HTTP 레지스트리(docker-group)에서 베이스 이미지 pull
              # Groovy 의 삼중따옴표 문자열은 줄 끝 백슬래시를 줄 연결로 먹어치운다.
              # 셸까지 백슬래시를 전달하려면 두 개로 적는다.
              /kaniko/executor --context "$WORKSPACE" --dockerfile Dockerfile \\
                --build-arg "APP_VERSION=${IMAGE_TAG}" \\
                --destination "${IMAGE}:${IMAGE_TAG}" \\
                --destination "${IMAGE}:${GIT_COMMIT}" \\
                --insecure --skip-tls-verify --insecure-pull
            '''
          }
        }
      }
    }

    stage('prod 승인') {
      when { expression { env.DEPLOY_ENV == 'prod' } }
      steps {
        // GitLab CI 의 `when: manual` 에 해당한다. 타임아웃은 전체 파이프라인 것과 별개다.
        timeout(time: 60, unit: 'MINUTES') {
          input message: "prod 에 ${env.IMAGE_TAG} 를 배포할까요?", ok: '배포'
        }
      }
    }

    stage('gitops 태그 갱신') {
      when { expression { env.DEPLOY_ENV } }
      steps {
        container('tools') {
          withCredentials([usernamePassword(credentialsId: 'gitops-repo',
                                            usernameVariable: 'GITOPS_USER',
                                            passwordVariable: 'GITOPS_TOKEN')]) {
            sh '''
              set -eu
              rm -rf gitops
              git config --global user.email "ci@example.com"
              git config --global user.name "jenkins-ci"
              git clone --depth 1 "http://${GITOPS_USER}:${GITOPS_TOKEN}@${GITOPS_REPO}" gitops

              cd gitops/manifests/sample-app/overlays/${DEPLOY_ENV}
              # 왼쪽은 overlay 의 images[].name (고정 이름), 오른쪽이 새 이미지다.
              kustomize edit set image "nexus-docker.example.com/my-group/sample-app=${IMAGE}:${IMAGE_TAG}"

              cd "$WORKSPACE/gitops"
              git add -A
              # 변경이 없으면 빈 커밋을 만들지 않고 그대로 끝낸다.
              if git diff --cached --quiet; then
                echo "변경 없음 - 커밋 생략"
                exit 0
              fi
              git commit -m "chore(${DEPLOY_ENV}): sample-app -> ${IMAGE_TAG}"
              git push origin HEAD:main
            '''
          }
        }
      }
    }

    stage('배포 대기') {
      when { expression { env.DEPLOY_ENV } }
      steps {
        container('argocd') {
          withCredentials([string(credentialsId: 'argocd-auth-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
            sh '''
              set -eu
              # Argo CD Ingress 가 평문(HTTP)이므로 --plaintext 가 필요하다.
              OPTS="--grpc-web --plaintext --server $ARGOCD_SERVER --auth-token $ARGOCD_AUTH_TOKEN"
              APP="sample-app-${DEPLOY_ENV}"

              # 방금 커밋을 바로 보게 한다(webhook 이 먼저 했어도 무해)
              argocd app get "$APP" --refresh $OPTS > /dev/null

              # dev 는 자동 동기화라 CLI 가 sync 를 또 걸면
              # "another operation is already in progress" 로 실패할 수 있다.
              # 수동 동기화 대상(prod)만 sync 한다.
              if [ "$DEPLOY_ENV" = "prod" ]; then
                argocd app sync "$APP" $OPTS
              fi
              argocd app wait "$APP" --sync --health --timeout 600 $OPTS
            '''
          }
        }
      }
    }
  }

  post {
    success {
      script {
        if (env.DEPLOY_ENV) {
          def url = (env.DEPLOY_ENV == 'dev') ? 'http://sample-app.dev.example.com'
                                              : 'http://sample-app.example.com'
          echo "배포 완료: ${env.DEPLOY_ENV} → ${url} (version: ${env.IMAGE_TAG})"
        }
      }
    }
    cleanup { cleanWs() }
  }
}
