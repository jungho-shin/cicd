// ===========================================================================
// PostgreSQL 버전 변경 배포 (README 9.5).
// gitops-manifests 리포지토리의 pipelines/postgres/Jenkinsfile 로 두고, Jenkins 에서
// 일반 Pipeline 잡(postgres-deploy)이 "Pipeline script from SCM" 으로 읽는다.
// 트리거가 없으므로 사람이 "Build with Parameters" 로 돌릴 때만 실행된다.
//
// 흐름: 현재 태그 읽기 → Docker Hub 에서 버전 목록 조회 → [버전 선택 화면(input)]
//       → (메이저가 바뀌면) 확인 → pg_dumpall 백업
//       → gitops 태그 갱신 커밋 → Argo CD 배포 완료까지 대기
//       → (메이저가 바뀌면) 새 메이저에 복원
//
// 메이저 변경: 데이터 디렉터리가 메이저별(/var/lib/postgresql/<메이저>/docker)이라
// 새 메이저는 빈 디렉터리에서 initdb 한다. 그래서 바꾸기 전에 덤프를 떠서 바꾼 뒤 복원한다.
// 이전 메이저의 디렉터리와 덤프 파일(/var/lib/postgresql/backup/)은 PV 에 그대로 남는다.
//
// 에이전트는 bootstrap/jenkins/casc.yaml 의 Pod 템플릿 `build` 를 쓴다.
// 컨테이너: python(버전 목록 조회) / tools(git·kustomize·kubectl) / argocd
// kubectl exec 권한은 manifests/postgres/base/rbac.yaml 이 postgres-* 네임스페이스에만 준다.
//
// 자격증명(JCasC 가 jenkins-secrets 에서 주입, README 5.2 참고)
//   gitops-repo        GitLab Group access token (ci-bot) — gitops push
//   argocd-auth-token  argocd account generate-token --account cicd
// ===========================================================================
pipeline {
  agent { label 'build' }

  parameters {
    // 첫 실행 전에는 Jenkins 가 이 목록을 모른다. 첫 빌드는 기본값(dev)으로 돌고
    // 버전 선택 화면에서 멈추므로, 거기서 Abort 해도 된다(README 9.5).
    choice(name: 'TARGET_ENV', choices: ['dev', 'prod'], description: '배포할 환경')
  }

  options {
    timestamps()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }

  environment {
    // 파라미터는 셸에서 직접 쓰지 않고 이 값으로 받는다. 새 잡의 첫 실행에는 파라미터가 아직 등록되지 않아
    // 셸 환경변수 TARGET_ENV 가 없고, set -u 때문에 "TARGET_ENV: parameter not set" 으로 바로 실패한다(2026-09-26 #1).
    DEPLOY_ENV    = "${params.TARGET_ENV ?: 'dev'}"
    APP_NAME      = 'postgres'
    // manifests/postgres 의 images[].name 과 같아야 한다
    IMAGE         = 'nexus-docker-group.example.com/library/postgres'
    // 버전 목록은 Docker Hub 에서 받는다(Nexus 프록시는 태그 목록 조회가 느리고 불완전할 수 있다)
    HUB_TAGS_URL  = 'https://hub.docker.com/v2/repositories/library/postgres/tags'
    // 드롭다운에 보일 메이저. 현재 메이저는 여기 없어도 항상 들어간다. 아직 안 나온 메이저는 건너뛴다
    MAJORS        = '15 16 17 18 19'
    // 스킴 없이 적는다. 아래에서 http:// 를 붙인다
    GITOPS_REPO   = 'gitlab.example.com/my-group/gitops-manifests.git'
    // 평문 Ingress. 포트를 생략하면 443 으로 붙을 수 있다
    ARGOCD_SERVER = 'argocd.example.com:80'
  }

  stages {
    stage('현재 버전') {
      steps {
        container('tools') {
          withCredentials([usernamePassword(credentialsId: 'gitops-repo',
                                            usernameVariable: 'GITOPS_USER',
                                            passwordVariable: 'GITOPS_TOKEN')]) {
            sh '''
              set -eu
              rm -rf gitops
              git clone --depth 1 "http://${GITOPS_USER}:${GITOPS_TOKEN}@${GITOPS_REPO}" gitops
              # 렌더링 결과에서 실제로 배포될 이미지 태그를 읽는다
              kustomize build "gitops/manifests/${APP_NAME}/overlays/${DEPLOY_ENV}" \
                | awk -v img="${IMAGE}:" 'index($0, img) { sub(".*" img, ""); print; exit }' > current.txt
              echo "현재 ${DEPLOY_ENV}: $(cat current.txt)"
              test -s current.txt
            '''
          }
        }
      }
    }

    stage('버전 목록') {
      steps {
        container('python') {
          // 스크립트는 앞 단계에서 받은 gitops 리포지토리에 이 Jenkinsfile 과 함께 있다.
          sh "python3 gitops/pipelines/${APP_NAME}/list-versions.py"
        }
      }
    }

    stage('버전 선택') {
      steps {
        script {
          def current  = readFile('current.txt').trim()
          def versions = readFile('versions.txt').trim().readLines()
          // 빌드 화면의 "Input requested" 또는 단계 뷰의 일시정지 칸을 누르면 드롭다운이 뜬다.
          // prod 는 이 화면이 곧 승인 단계다.
          timeout(time: 30, unit: 'MINUTES') {
            env.PG_VERSION = input(
              message: "${env.DEPLOY_ENV} 의 postgres 버전을 고른다 (현재 ${current})",
              ok: '배포',
              parameters: [choice(name: 'PG_VERSION', choices: versions.join('\n'),
                                  description: '메이저별 최신순. 메이저가 바뀌면 백업 → 새 데이터 디렉터리 → 복원을 한다')]
            )
          }
          env.CUR_VERSION  = current
          env.CUR_MAJOR    = current.tokenize('.')[0]
          env.NEW_MAJOR    = env.PG_VERSION.tokenize('.')[0]
          env.MAJOR_CHANGE = (env.CUR_MAJOR != env.NEW_MAJOR) ? 'true' : 'false'

          if (env.MAJOR_CHANGE == 'true') {
            def msg = "메이저 변경 ${env.CUR_MAJOR} → ${env.NEW_MAJOR}: pg_dumpall 백업 → 새 데이터 디렉터리에서 initdb → 복원. " +
                      "그동안 DB 가 멈추고, 백업 뒤에 들어온 쓰기는 옮겨지지 않는다(앱 쓰기를 먼저 멈춘다)."
            if (Integer.parseInt(env.NEW_MAJOR) < Integer.parseInt(env.CUR_MAJOR)) {
              msg += " 낮은 메이저로 내리는 복원은 새 버전에만 있는 문법 때문에 실패할 수 있다."
            }
            timeout(time: 30, unit: 'MINUTES') {
              input message: msg, ok: '진행'
            }
          } else if (env.PG_VERSION == current) {
            echo "현재와 같은 버전(${current}) - 태그 커밋 없이 상태만 확인한다"
          }
          currentBuild.description = "${env.DEPLOY_ENV}: ${current} → ${env.PG_VERSION}"
        }
      }
    }

    stage('백업 (메이저 변경)') {
      when { expression { env.MAJOR_CHANGE == 'true' } }
      steps {
        container('tools') {
          sh '''
            set -eu
            NS="postgres-${DEPLOY_ENV}"
            POD="${DEPLOY_ENV}-postgres-0"
            TS=$(date +%Y%m%d-%H%M%S)
            # PV 안에 둔다. 새 파드도 같은 PV 를 붙이므로 복원 때 그대로 읽는다
            BACKUP="/var/lib/postgresql/backup/pg${CUR_MAJOR}-to-pg${NEW_MAJOR}-${TS}.sql"

            # 파드 안의 유닉스 소켓으로 붙는다(공식 이미지는 local 접속이 trust — 비밀번호가 필요 없다)
            kubectl -n "$NS" exec "$POD" -- bash -c "mkdir -p /var/lib/postgresql/backup && pg_dumpall -U app -f '$BACKUP'"
            kubectl -n "$NS" exec "$POD" -- ls -l "$BACKUP"

            # 새 메이저의 디렉터리가 이미 있으면(예전에 그 메이저를 쓰다 바꾼 경우) 옆으로 치운다.
            # 그대로 두면 그 옛 데이터로 떠서 덤프 복원과 섞인다. 지우지 않으므로 필요하면 되살릴 수 있다
            TARGET_DIR="/var/lib/postgresql/${NEW_MAJOR}"
            kubectl -n "$NS" exec "$POD" -- bash -c "if [ -e '$TARGET_DIR' ]; then mv '$TARGET_DIR' '${TARGET_DIR}.old-${TS}' && echo 'moved $TARGET_DIR -> ${TARGET_DIR}.old-${TS}'; fi"

            echo "$BACKUP" > backup.txt
          '''
        }
      }
    }

    stage('gitops 태그 갱신') {
      steps {
        container('tools') {
          withCredentials([usernamePassword(credentialsId: 'gitops-repo',
                                            usernameVariable: 'GITOPS_USER',
                                            passwordVariable: 'GITOPS_TOKEN')]) {
            sh '''
              set -eu
              git config --global user.email "ci@example.com"
              git config --global user.name "jenkins-ci"
              # 목록을 보는 사이 다른 커밋이 들어왔을 수 있으니 새로 받는다
              rm -rf gitops
              git clone --depth 1 "http://${GITOPS_USER}:${GITOPS_TOKEN}@${GITOPS_REPO}" gitops

              cd gitops/manifests/${APP_NAME}/overlays/${DEPLOY_ENV}
              kustomize edit set image "${IMAGE}=${IMAGE}:${PG_VERSION}"

              cd "$WORKSPACE/gitops"
              git add -A
              if git diff --cached --quiet; then
                echo "변경 없음 - 커밋 생략"
                exit 0
              fi
              git commit -m "chore(${DEPLOY_ENV}): ${APP_NAME} ${CUR_VERSION} -> ${PG_VERSION}"
              git push origin HEAD:main
            '''
          }
        }
      }
    }

    stage('배포 대기') {
      steps {
        container('argocd') {
          withCredentials([string(credentialsId: 'argocd-auth-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
            sh '''
              set -eu
              OPTS="--grpc-web --plaintext --server $ARGOCD_SERVER --auth-token $ARGOCD_AUTH_TOKEN"
              APP="${APP_NAME}-${DEPLOY_ENV}"

              argocd app get "$APP" --refresh $OPTS > /dev/null
              # dev 는 자동 동기화라 prod 만 sync 한다(ci/Jenkinsfile 과 같은 이유)
              if [ "$DEPLOY_ENV" = "prod" ]; then
                argocd app sync "$APP" $OPTS
              fi
              argocd app wait "$APP" --sync --health --timeout 600 $OPTS
            '''
          }
        }
      }
    }

    stage('복원 (메이저 변경)') {
      when { expression { env.MAJOR_CHANGE == 'true' } }
      steps {
        container('tools') {
          sh '''
            set -eu
            NS="postgres-${DEPLOY_ENV}"
            POD="${DEPLOY_ENV}-postgres-0"
            BACKUP=$(cat backup.txt)

            kubectl -n "$NS" wait --for=condition=Ready "pod/$POD" --timeout=300s
            VER=$(kubectl -n "$NS" exec "$POD" -- psql -U app -d postgres -tAc 'show server_version')
            echo "새 서버 버전: $VER"
            case "$VER" in
              "${NEW_MAJOR}".*) ;;
              *) echo "새 메이저(${NEW_MAJOR})로 바뀌지 않았다 - 복원하지 않는다"; exit 1 ;;
            esac

            # 오류가 나도 끝까지 돈다. initdb 가 이미 만든 app 사용자·app DB 의 "already exists" 는 예상된 오류다
            kubectl -n "$NS" exec "$POD" -- psql -U app -d postgres -X -q -f "$BACKUP" > restore.log 2>&1 || true
            grep 'ERROR' restore.log > errors.txt || true
            grep -v 'already exists' errors.txt > unexpected.txt || true
            echo "복원 오류 $(wc -l < errors.txt)건 (예상된 already exists 를 뺀 나머지 $(wc -l < unexpected.txt)건)"
            if [ -s unexpected.txt ]; then
              cat unexpected.txt
              echo "백업 파일은 PV 에 남아 있다: $BACKUP (README 9.5 되돌리기)"
              exit 1
            fi
            kubectl -n "$NS" exec "$POD" -- psql -U app -d app -c '\\dt'
          '''
        }
      }
    }
  }

  post {
    success {
      echo "배포 완료: ${env.DEPLOY_ENV} → postgres ${env.PG_VERSION}"
    }
    always {
      // 복원 로그는 데이터가 아니라 psql 메시지뿐이라 남겨 둔다
      archiveArtifacts artifacts: 'restore.log', allowEmptyArchive: true
    }
    cleanup { cleanWs() }
  }
}
